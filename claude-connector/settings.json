      "Bash(python3 .claude/scripts/graph.py *)",
      "Bash(python3 .claude/scripts/graph_colors.py)",
      "Bash(python3 .claude/scripts/build_canvases.py)",
      "Bash(python3 .claude/scripts/build_canvases.py *)",
      "Edit(.obsidian/graph.json)",
      "mcp__chalkenso__list_courses",
      "mcp__chalkenso__get_course_outline",
      "mcp__chalkenso__get_course_health",
      "mcp__chalkenso__get_lesson",
      "mcp__chalkenso__get_revision_brief",
      "mcp__chalkenso__get_task",
      "mcp__chalkenso__list_tasks",
      "mcp__chalkenso__list_proposals"
